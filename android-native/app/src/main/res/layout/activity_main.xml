<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0d14"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#e8ebf5"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:textColor="#8d93ab"
        android:textSize="13sp"
        android:text="@string/status_no_model" />

    <TextView
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#141826"
        android:padding="12dp"
        android:textColor="#e8ebf5"
        android:textSize="15sp"
        android:scrollbars="vertical"
        android:textIsSelectable="true" />

    <Button
        android:id="@+id/model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_model"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_input"
            android:textColor="#e8ebf5"
            android:textColorHint="#8d93ab"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:imeOptions="actionSend"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_send" />
    </LinearLayout>

    <Button
        android:id="@+id/talk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/action_talk"
        android:textSize="17sp" />
</LinearLayout>
